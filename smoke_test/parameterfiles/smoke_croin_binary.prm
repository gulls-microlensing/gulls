RUN_NAME=smoke_croin_binary
OUTPUT_DIR=smoke_test/output/croin/
FINAL_DIR=smoke_test/output/croin/
EXECUTABLE=gulls_croin

OBSERVATORY_DIR=smoke_test/assets/observatories/
OBSERVATORY_LIST=smoke.list

WEATHER_PROFILE_DIR=smoke_test/assets/weather/

STARFIELD_DIR=smoke_test/assets/starfields/
STARFIELD_LIST=smoke.starfields

SOURCE_DIR=smoke_test/assets/sources/
SOURCE_LIST=smoke_binary.sources
SOURCE_COLOURS=0

LENS_DIR=smoke_test/assets/lenses/
LENS_LIST=smoke.lenses
LENS_COLOURS=0

PLANET_DIR=smoke_test/assets/planets/
PLANET_ROOT=smoke.planets.

RATES_FILE=smoke_test/assets/rates/smoke.rates

PRINCIPLE_OBSERVATORY=0
OUTPUT_LC=1
OUTPUT_IMAGES=1
PRETTY_PICS=1
PRETTY_PICS_DIMENSIONS=32
OUTPUT_ONERR=0
OUTPUT_ONDET=1
OUTPUT_ONALL=1
PARALLAX=1
LENS_LIGHT=1

SET_RANDOM_SEED_TO_CLOCK=0
RANDOM_SEED=12345
SIMULATION_ZERO_TIME=2458849.0

SUBRUNSIZE=1

NFILTERS=32
AMIN=1.0001
LARGEPSFMAG=25.0
MIN_CHISQUARED=0.0
U0MAX=1.0

LC_GEN=1
LD_GAMMA=0.1
VBM_RELTOL=1.0e-6
VBM_ABSTOL=1.0e-4
LC_TIMEOUT=10.0

NUM_SIM_DAYS=200

REPEAT_SEQUENCE=0
OBS_GROUPS=(ALL)
OBS_GROUP_NAMES=smoke
ERROR_SCALING=0
MULTIPLE_SOURCES=1
MULTIPLE_LENSES=0

ASTROMETRY_ON=1
ASTROMETRIC_SYS_FLOOR=0.0
